# Data — training-only artifacts not shipped; canary set is the exception.
# Leading slash anchors to the repo root so src/data/ (Python package) is unaffected.
/data/
!/data/canary/
!/data/canary/*

# Trained models — too large for git, fetched from HF Hub at deploy time
models/bakeoff/
models/ensemble/
models/error_analysis/
models/*.pkl
models/*.joblib
models/*.bin
models/*.safetensors
models/*.txt
models/*.png
# But DO track the ensemble manifest + label map (small, critical for runtime)
!models/ensemble_final/
!models/ensemble_final/*.json
!models/single_final/
!models/single_final/*.json
!models/label_map.json

# Local-only docs
PROJECT_HANDOFF.md
team_message.pdf
documentation.pdf
CLAUDE_AMBIENCE_DATA_PIPELINE_HANDOFF.md

# Pipeline smoke-run + pytest temp artifacts (generated by importer scripts
# and pytest --basetemp on Windows when default temp dirs are restricted)
smoke_*/
tests_tmp*/

# v5 training artifacts — large checkpoints + logs + per-run eval reports.
# Keep the senior review and run results docs in docs/ instead.
models/single_ambience_v1/
models/ensemble_ambience_v1/
logs/
reports/

# Python
__pycache__/
*.py[cod]
*.pyo
.env
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Tooling
.claude/

# Pytest
.pytest_cache/
.coverage
htmlcov/

# CI artifacts
*.log

# Gradio cache
.gradio/
